#!/usr/bin/env python3
"""Call the GitHub REST API with the stored custom.github credential.

Usage:
    gh-api <path> [json-body-file]
    gh-api /user/repos?per_page=100
    gh-api /repos/awei-git/REPO --method PATCH --data '{"description":"..."}'

Prints the response body to stdout. Exits non-zero on HTTP errors.
"""
import json
import sys
import urllib.request
import urllib.error

sys.path.insert(0, "/opt/hatch/skills/skill-creator/bin")
from dynamic_credentials import (  # noqa: E402
    add_surrogate_to_request,
    read_response_body,
)

BASE = "https://api.github.com"
ALLOWED = ["api.github.com"]


def main() -> int:
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    path = args[0]
    method = "GET"
    data = None
    i = 1
    while i < len(args):
        if args[i] == "--method" and i + 1 < len(args):
            method = args[i + 1].upper()
            i += 2
        elif args[i] == "--data" and i + 1 < len(args):
            data = args[i + 1].encode()
            i += 2
        else:
            i += 1

    url = BASE + (path if path.startswith("/") else "/" + path)
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("Accept", "application/vnd.github+json")
    req.add_header("X-GitHub-Api-Version", "2022-11-28")
    req.add_header("User-Agent", "mira-github-skill")
    if data is not None:
        req.add_header("Content-Type", "application/json")
    add_surrogate_to_request(
        req, "custom.github", entry_name="access_token", allowed_hosts=ALLOWED
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            body = read_response_body(resp)
    except urllib.error.HTTPError as e:
        err_body = e.read().decode("utf-8", "replace")[:2000]
        print(f"HTTP {e.code}: {err_body}", file=sys.stderr)
        return 1
    sys.stdout.write(body.decode("utf-8", "replace"))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
