#!/usr/bin/env python3
"""Call the OpenAI REST API with the stored custom.openai credential.

Usage:
    openai-api <path> [options]
    openai-api /v1/models
    openai-api /v1/chat/completions --data '{"model":"gpt-5.6","messages":[...]}'

Prints the response body to stdout. Exits non-zero on HTTP errors.
Never prints the credential; auth is injected as a surrogate by authd.
"""
import json
import sys
import urllib.request
import urllib.error

sys.path.insert(0, "/opt/hatch/skills/skill-creator/bin")
from dynamic_credentials import (  # noqa: E402
    add_surrogate_to_request,
    read_response_body,
)

BASE = "https://api.openai.com"
ALLOWED = ["api.openai.com"]


def main() -> int:
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    path = args[0]
    method = "GET"
    data = None
    i = 1
    while i < len(args):
        if args[i] == "--method" and i + 1 < len(args):
            method = args[i + 1].upper()
            i += 2
        elif args[i] == "--data" and i + 1 < len(args):
            data = args[i + 1].encode()
            i += 2
        elif args[i] == "--data-file" and i + 1 < len(args):
            with open(args[i + 1], "rb") as f:
                data = f.read()
            i += 2
        else:
            i += 1

    url = BASE + (path if path.startswith("/") else "/" + path)
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("User-Agent", "mira-openai-skill")
    if data is not None:
        req.add_header("Content-Type", "application/json")
    add_surrogate_to_request(
        req, "custom.openai", entry_name="access_token", allowed_hosts=ALLOWED
    )
    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            body = read_response_body(resp)
    except urllib.error.HTTPError as e:
        err_body = e.read().decode("utf-8", "replace")[:2000]
        print(f"HTTP {e.code}: {err_body}", file=sys.stderr)
        return 1
    sys.stdout.write(body.decode("utf-8", "replace"))
    return 0


if __name__ == "__main__":
    sys.exit(main())
