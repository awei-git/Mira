+# CLOUD-OVERLAY(substack-ec2): safe-start cutover for comment dedup.
+# Dedup state could not be migrated from the Mac; ignore (but mark seen) any
+# comment older than the EC2 cutover timestamp.
+_CUTOVER_FILE = Path("/opt/mira/substack-data/cutover.txt")
+
+
+def _cutover_ts():
+    try:
+        from datetime import datetime
+
+        if _CUTOVER_FILE.exists():
+            return datetime.fromisoformat(_CUTOVER_FILE.read_text(encoding="utf-8").strip())
+    except Exception:
+        pass
+    return None
+
+
+def _predates_cutover(date_str: str) -> bool:
+    if not date_str:
+        return False
+    cutover = _cutover_ts()
+    if not cutover:
+        return False
+    try:
+        from datetime import datetime
+
+        ds = date_str.strip()
+        # Substack dates are ISO-8601; fromisoformat handles 'Z' on py3.11+
+        ts = datetime.fromisoformat(ds.replace("Z", "+00:00"))
+        if ts.tzinfo is None:
+            from datetime import timezone
+
+            ts = ts.replace(tzinfo=timezone.utc)
+        co = cutover
+        if co.tzinfo is None:
+            from datetime import timezone
+
+            co = co.replace(tzinfo=timezone.utc)
+        return ts < co
+    except Exception:
+        return False
+
